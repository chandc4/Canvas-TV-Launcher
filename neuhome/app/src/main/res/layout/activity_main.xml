<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Double-Buffered Wallpaper Surface: Layer A (Base) -->
    <ImageView
        android:id="@+id/wallpaperImageViewA"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="1"
        android:src="@drawable/default_wallpaper"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Double-Buffered Wallpaper Surface: Layer B (Overlay) -->
    <ImageView
        android:id="@+id/wallpaperImageViewB"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Adjustable Dim Scrim -->
    <View
        android:id="@+id/scrimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Extreme Top Bar: Clock (Far Left) & Transparent Settings (Far Right) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextClock
                android:id="@+id/clockView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="HH:mm"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textColor="#F1F3F5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Transparent Settings Button at Extreme Top Right -->
        <ImageButton
            android:id="@+id/btnLauncherSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_transparent_selector"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_preferences"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Extreme Bottom-Left Minimal Dock (Lowered to bottom corner) -->
    <LinearLayout
        android:id="@+id/bottomDockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="bottom|start"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appDockRecyclerView"
            android:layout_width="wrap_content"
            android:layout_height="108dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- Professional Studio Hub Modal (two-pane) -->
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D90D0E12"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="980dp"
            android:layout_height="620dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_settings_panel"
            android:orientation="horizontal"
            android:padding="0dp">

            <!-- Left Navigation Rail -->
            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:background="#1A1D23"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="Canvas TV"
                    android:textColor="@color/accent_focus"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSystemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="TV System Settings"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/navWallpapers"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Wallpapers"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/navMovies"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Movies"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/navAmbient"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Ambient"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/navDock"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Dock &amp; Dim"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/navApps"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Apps"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/navTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Transfer"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSetDefaultLauncher"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_btn"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Set as Default Home"
                    android:textColor="@color/accent_focus"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Right Content -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="24dp"
                android:paddingTop="40dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Page: Wallpapers -->
                    <LinearLayout
                        android:id="@+id/pageWallpapers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/galleryHeader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Wallpapers on TV"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnDeleteCurrentWallpaper"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="Delete Current"
                                android:textColor="#EF5350"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Click to apply • Long-press to delete"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/wallpapersRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/noWallpapersNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="No wallpapers uploaded yet. Use Transfer to add."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Page: Movies -->
                    <LinearLayout
                        android:id="@+id/pageMovies"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/moviesHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Movies &amp; Videos"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Click to play in VLC • Long-press to delete"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/moviesRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="84dp"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/noMoviesNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="No videos yet. Upload .mp4 or .mkv from phone."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Page: Ambient -->
                    <LinearLayout
                        android:id="@+id/pageAmbient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ambient Wallpaper Rotation"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnRotOff"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="Off"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnRot15s"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="15s"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnRot30s"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="30s"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnRot1m"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="1m"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnRot1h"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="1h"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Keep screen on -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Keep Screen On (Ambient)"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/keepScreenOnSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Page: Dock & Dim -->
                    <LinearLayout
                        android:id="@+id/pageDock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dock Style"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnDockDecrease"
                                android:layout_width="48dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="-"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/txtDockCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnDockIncrease"
                                android:layout_width="48dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="+"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="0 = hidden dock. 1-10 = number of dock apps."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Wallpaper Dim Level"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnDimClear"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="Bright"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnDimDark"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dialog_btn"
                                android:focusable="true"
                                android:text="Dimmed"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Page: Transfer -->
                    <LinearLayout
                        android:id="@+id/pageTransfer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send Wallpapers &amp; Movies from Phone"
                            android:textColor="@color/accent_focus"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/qrCodeImageView"
                                android:layout_width="140dp"
                                android:layout_height="140dp"
                                android:contentDescription="@null" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/serverUrlText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Connect phone to the same Wi-Fi. Uploaded images become wallpapers; uploaded videos (.mp4, .mkv) appear in VLC/Nova."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Page: Apps -->
                    <LinearLayout
                        android:id="@+id/pageApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App Drawer"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Toggle visibility and reorder apps (Up/Down)."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/appsManageRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="360dp"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Page: System -->
                    <LinearLayout
                        android:id="@+id/pageSystem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Use the sidebar buttons for System Settings and Default Home."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="#1AFFFFFF"
                            android:padding="10dp"
                            android:text="Safe mode / recovery: If Canvas TV Launcher fails to start, open TV System Settings -> Apps -> Default apps (Home app) and select your stock launcher. You can also reboot and switch the default home there. Keep the stock launcher installed."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- All Apps Overlay (transient browse surface) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/allAppsOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D90B0D11"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Overlay Header -->
        <TextView
            android:id="@+id/allAppsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="40dp"
            android:text="Applications"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allAppsRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="48dp"
            android:paddingTop="80dp"
            android:paddingEnd="48dp"
            android:paddingBottom="32dp"
            android:scrollbars="none"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/allAppsHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
